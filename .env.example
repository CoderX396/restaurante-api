PORT=3000
NODE_ENV=development

# Opción A: URL completa (Neon, Supabase u otro servicio en la nube)
# DATABASE_URL=postgresql://usuario:clave@servidor/restaurante?sslmode=require

# Opción B: PostgreSQL instalado en la computadora
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurante
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=cambia_esta_clave_por_una_larga_y_secreta
JWT_EXPIRES_IN=8h
