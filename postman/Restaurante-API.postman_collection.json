        {
          "name": "Eliminar categoría (admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories/4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
