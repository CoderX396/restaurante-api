          "name": "Eliminar plato como mesero (403)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu-items/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "menu-items",
                "2"
              ]
            },
            "description": "Demuestra checkRole: debe responder 403.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{meseroToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
